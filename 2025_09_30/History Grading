#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <ostream>
#include <map>
#include <queue>
#include <stack>
#include <iomanip>
#include <numeric>
#include <algorithm>
using namespace std;



int main() {
    int n,first;
    while(cin>>n)
    {
        vector<int> correct(n+1);
        for(int i=1;i<=n;i++)
            cin>>correct[i];
        // for(int i=1;i<=n;i++)
        //     cout<<correct[i]<<" ";
        // cout<<endl;
        
        vector<int> student(n+1);
        while(cin>>first)
        {
            student[1] = first;
            for(int i=2;i<=n;i++)
                cin>>student[i];

            vector<int> arr(n+1);

            for(int i=1;i<=n;i++)
                arr[student[i]] = correct[i];
            //arr 的意義是：「學生排在第一、二、三、四名的事件，它們正確的位次分別是 3, 2, 4, 1」。

            vector<int> dp(n + 1, 1); // 每個元素預設長度都是 1
            int max_ans = 0;

            for (int i = 1; i <= n; i++) {
                for (int j = 1; j < i; j++) {
                    // 如果後面的數字比前面大，代表順序正確，可以串接
                    if (arr[i] > arr[j]) {
                        dp[i] = max(dp[i], dp[j] + 1);
                    }
                }
                // 紀錄過程中最長的長度
                max_ans = max(max_ans, dp[i]);
            }

            cout << max_ans << endl;
        }
    }
}	
