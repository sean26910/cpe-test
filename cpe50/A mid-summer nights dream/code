using namespace std;



int main() {
    int n;
    while (cin>>n)
    {
        vector<int> stor(n);
        int ans1,ans2=0,ans3;
        for(int i=0;i<n;i++)
            cin>>stor[i];
        sort(stor.begin(),stor.end());
        if(n%2)
        {
            ans1 = stor[n/2];
            for(int i=0;i<n;i++)
            {
                if(stor[i]==ans1)
                    ans2++;
            }
            ans3 = 1;
        }
        else
        {
            ans1 = stor[n/2-1];
            for(int i=0;i<n;i++)
            {
                if(stor[i]>=stor[n/2-1] && stor[i]<=stor[n/2])
                    ans2++;
            }
            ans3 = stor[n/2]-stor[n/2-1]+1;
        }
        cout<<ans1<<" "<<ans2<<" "<<ans3<<endl;
    }
}
