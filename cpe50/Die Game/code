//top north west east south bottom

int main() {
    int n;
    while(cin>>n)
    {
        if(n==0)
            break;
        string instruction;
        int dice[] = {1,2,3,4,5,6};
        int newdice[] = {1,2,3,4,5,6};
        for(int i=0;i<n;i++)
        {
            //top north west east south bottom
            cin>>instruction;
            if(instruction=="north")
            {
                newdice[0] = dice[4];
                newdice[1] = dice[0];
                newdice[4] = dice[5];
                newdice[5] = dice[1];
            }
            else if(instruction=="east")
            {
                newdice[0] = dice[2];
                newdice[2] = dice[5];
                newdice[3] = dice[0];
                newdice[5] = dice[3];
            }
            else if(instruction=="west")
            {
                newdice[0] = dice[3];
                newdice[2] = dice[0];
                newdice[3] = dice[5];
                newdice[5] = dice[2];
            }
            else
            {
                newdice[0] = dice[1];
                newdice[1] = dice[5];
                newdice[4] = dice[0];
                newdice[5] = dice[4];
            }
            for(int i=0;i<6;i++)
                dice[i] = newdice[i];
        }
        cout<<newdice[0]<<endl;
    }
}
