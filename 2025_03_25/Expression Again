            {
                for(int s=-2500;s<=2500;s++)
                {
                    if(dp[j][s+offset])
                        dp[j+1][s+x+offset] = true;
                }
            }
        }

        int maxans = INT_MIN;
        int minans = INT_MAX;

        for(int s = -2500;s<=2500;s++)
        {
            if(dp[n][s+offset])
            {
                int value = s*(total-s);

                maxans = max(maxans,value);
                minans = min(minans,value);
            }
        }
        cout<<maxans<<" "<<minans<<endl;
    }
