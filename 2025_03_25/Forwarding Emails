#include <algorithm>
#include <string.h>
using namespace std;

vector<int> graph;
vector<int> dp;
vector<int> pos;
vector<int> state;
vector<int> route;

void dfs(int u)
{
    state[u] = 1;
    pos[u] = route.size();
    route.push_back(u);

    int v = graph[u];

    if(state[v]==0)
    {
        dfs(v);
        if(dp[u]==-1)
            dp[u] = dp[v]+1;
    }
    else if(state[v]==1)
    {
        int cycle_len = route.size()-pos[v];
        for(int i=pos[v];i<route.size();i++)
            dp[route[i]] = cycle_len;

        if(dp[u]==-1)
            dp[u] = dp[v]+1;
    }
    else
        dp[u] = dp[v]+1;

    state[u] = 2;
    route.pop_back();
}

int main() {
    int t;
    cin>>t;
    for(int qu=1;qu<=t;qu++)
    {
        int n,u,v;
        cin>>n;
        graph.assign(n+1,0);
        dp.assign(n+1,-1);
        state.assign(n+1,0);
        pos.assign(n+1,-1);
        for(int i=0;i<n;i++)
        {
            cin>>u>>v;
            graph[u] = v;
        }

        for(int i=1;i<=n;i++)
        {
            if(state[i]==0)
            {
                route.clear();
                dfs(i);
            }
        }

        int ans = 1;
        int best = -1;

        for(int i=1;i<=n;i++)
        {
            if(dp[i]>best)
            {
                best = dp[i];
                ans = i;
            }
        }
        cout<<"Case "<<qu<<": "<<ans<<endl;
    }
}
