#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <ostream>
#include <map>
#include <queue>
#include <stack>
#include <iomanip>
#include <numeric>
#include <algorithm>
using namespace std;

struct Edge
{
    int to;
    int w;
};

int main() {
    int n,m;
    //n vertices
    while(cin>>n>>m)
    {
        if(n==0 && m==0)
            break;

        int x,y,k,u,v,l;
        long long INF = 1e18,ans=-1;

        cin>>x>>y>>k;

        vector<vector<Edge>> graph(n+1);
        vector<long long> dist(n+1,0);

        priority_queue<pair<long long,int>,vector<pair<long long,int>>,greater<pair<long long,int>>> pq;

        for(int i=0;i<m;i++)
        {
            cin>>u>>v>>l;
            graph[u].push_back({v,l});
        }

        dist[x] = 0;
        pq.push({0,x});

        while(!pq.empty())
        {
            auto node = pq.top();
            pq.pop();

            long long d = node.first;
            int cur = node.second;
            dist[cur]++;

            if(dist[cur]>k)
                continue;

            if(cur==y && dist[cur]==k)
            {
                ans = d;
                break;
            }

            for(auto e:graph[cur])
            {
                int next = e.to;
                int w = e.w;
                pq.push({d+w,next});
            }
        }

        cout << ans << endl;
    }
}
