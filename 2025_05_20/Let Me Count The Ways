#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <ostream>
#include <map>
#include <queue>
#include <stack>
#include <iomanip>
#include <numeric>
#include <algorithm>
#define MAXN 10000000
using namespace std;

int coins[] = {1,5,10,25,50};

int main() {
    int n;
    while(cin>>n)
    {
        vector<long long> dp(n+1);
        dp[0] = 1;
        
        for(int i=0;i<5;i++)
        {
            for(int j=coins[i];j<=n;j++)
                dp[j] += dp[j-coins[i]];
        }
        if(dp[n]==1)
            cout<<"There is only 1 way to produce "<<n<<" cents change.\n";
        else
            cout<<"There are "<<dp[n]<<" ways to produce "<<n<<" cents change.\n";
    }
}	
