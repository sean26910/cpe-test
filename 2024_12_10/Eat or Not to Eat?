using namespace std;

struct cows
{
	int cycle;
	vector<int> mi;
	bool alive;
};

int main() {
    int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		vector<cows> stor(n);
		for(int i=0;i<n;i++)
		{
			cin>>stor[i].cycle;
			stor[i].mi.resize(stor[i].cycle);
			for(int j=0;j<stor[i].cycle;j++)
				cin>>stor[i].mi[j];
			stor[i].alive = true;
		}

		int alive_count = n;
		int lasteatday = 0;
		int noeatday = 0;
		int days = 1;

		while(noeatday<2520)
		{
			int minmilk = INT_MAX;
			int mincow = -1;
			bool duplicate = false;

			for(int i=0;i<n;i++)
			{
				if(!stor[i].alive)
					continue;
				int idx = (days-1)%stor[i].cycle;
				int curmilk = stor[i].mi[idx];
				if(curmilk<minmilk)
				{
					duplicate = false;
					minmilk = curmilk;
					mincow = i;
				}
				else if(curmilk==minmilk)
					duplicate = true;
			}

			if(!duplicate && mincow!=-1)
			{
				alive_count--;
				stor[mincow].alive = false;
				lasteatday = days;
				noeatday = 0;
			}
			else
				noeatday++;
			days++;
		}
		cout<<alive_count<<" "<<lasteatday<<endl;
	}
}
