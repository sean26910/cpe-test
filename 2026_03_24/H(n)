using namespace std;

long long H(int n){
    long long res = 0;
    for( long long i = 1; i <= n; i++ ){
		int j = floor(n/floor(n/i));
		res+=(j-i+1)*floor(n/i);
		i=j;
    }
    return res;
}

int main() {
	int t;
	cin>>t;
	while(t--)
	{
		int n;
		cin>>n;
		cout<<H(n)<<endl;
	}
}
	
