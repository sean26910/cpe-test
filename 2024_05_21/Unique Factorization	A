using namespace std;

vector<vector<int>> ans;
vector<int> path;
void dfs(int n,int start)
{
	for(int i=start;i*i<=n;i++)
	{
		if(n%i==0)
		{
			path.push_back(i);
			vector<int> temp = path;
			temp.push_back(n/i);

			ans.push_back(temp);

			dfs(n/i,i);

			path.pop_back();
		}
	}
}

int main()
{
    int n;
	while(cin>>n)
	{
		if(n==0)
			break;

		ans.clear();
		path.clear();
		dfs(n,2);

		if(ans.size())
		{
			sort(ans.begin(),ans.end());
			cout<<ans.size()<<endl;

			for(int i=0;i<ans.size();i++)
			{
				for(int j=0;j<ans[i].size();j++)
				{
					if(j)
						cout<<" ";
					cout<<ans[i][j];
				}
				cout<<endl;
			}
		}
		else
			cout<<0<<endl;
	}
}
